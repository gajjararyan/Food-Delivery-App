{
  "expo": {
    "name": "GharKaSwad",
    "slug": "gharkaswad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "gharkaswad",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow GharKaSwad to use your location to pin your kitchen on the map."
        }
      ],
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}",
          "androidGoogleMapsApiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gharkaswad.customer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fff8f5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.gharkaswad.customer",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "replace-with-eas-project-id"
      },
      "supabaseUrl": "${EXPO_PUBLIC_SUPABASE_URL}",
      "supabaseAnonKey": "${EXPO_PUBLIC_SUPABASE_ANON_KEY}",
      "apiUrl": "${EXPO_PUBLIC_API_URL}",
      "googleMapsApiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}",
      "razorpayKeyId": "${EXPO_PUBLIC_RAZORPAY_KEY_ID}",
      "sentryDsn": "${EXPO_PUBLIC_SENTRY_DSN}"
    }
  }
}
