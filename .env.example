# App (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_URL=https://your-render-service.onrender.com
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Backend only — never put these in the Expo app
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
RESEND_API_KEY=re_xxxxxxxx
SENTRY_AUTH_TOKEN=
PORT=3001

# ------------------------------------------------------------
# Where to get each key
# ------------------------------------------------------------
# Supabase URL / anon / service role:
#   https://supabase.com/dashboard → Project → Settings → API
# Razorpay key id + secret (test mode):
#   https://dashboard.razorpay.com → Account & Settings → API Keys
# Render API base URL:
#   https://dashboard.render.com → your Web Service → URL
# Sentry DSN:
#   https://sentry.io → Project Settings → Client Keys (DSN)
# Google Maps (kitchen pin + live tracking — web + native):
#   https://console.cloud.google.com → APIs & Services → Credentials → Create API key
#   Enable: Geocoding API, Maps JavaScript API (web), Maps SDK for Android, Maps SDK for iOS
#   Restrict key by HTTP referrer (web) and app bundle id (mobile) before production
#   EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
#   Chef → Menu → Kitchen location uses this key to search/pin the cook kitchen.
#   Without a key, OpenStreetMap search + device GPS still save lat/lng locally.
# Firebase (Analytics + FCM):
#   https://console.firebase.google.com → Project settings
# Phone Auth (Supabase):
#   Dashboard → Authentication → Providers → Phone
#   For pilot SMS, connect Twilio under Auth → Settings → SMS
#   Without SMS provider configured, OTP send will fail — use Supabase test numbers if available
#
# OTP rate limiting:
#   Set EXPO_PUBLIC_API_URL to the Express API (local http://localhost:3001 or Render).
#   POST /auth/otp/send is limited to 5 requests / 15 minutes per IP+phone.
#   If API URL is empty, the app falls back to direct Supabase OTP (dev only).
#
# Local testing without Supabase (recommended for first run):
#   EXPO_PUBLIC_SUPABASE_URL=
#   EXPO_PUBLIC_SUPABASE_ANON_KEY=
#   EXPO_PUBLIC_API_URL=
#   EXPO_PUBLIC_DEV_AUTH=true
#   Login with any valid Indian mobile after signup; OTP is 654321 (not shown in the UI).
#   Discover/cart/checkout use the offline Nani Geeta seed catalog.
#   Role separation (dev):
#     Customer: Create account → OTP → Sign in (any 6–9… number)
#     Chef: apply + admin approve, then chef dashboard
#     Admin only: 1234567890 → Sign in (no customer signup)
#   EXPO_PUBLIC_ADMIN_PHONES=+911234567890
#   EXPO_PUBLIC_DEV_OTP=654321
EXPO_PUBLIC_DEV_AUTH=true
EXPO_PUBLIC_DEV_OTP=654321
EXPO_PUBLIC_ADMIN_PHONES=+911234567890
#
# Payments (Step 5):
#   EXPO_PUBLIC_RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET on the API for real sandbox orders.
#   POST /payments/create-order, /payments/verify, /payments/webhook, /payments/sandbox-confirm
#   Without keys, checkout uses sandbox-confirm (still reuses payment_pending orders → no double charge).
#   ALLOW_SANDBOX_CONFIRM=false when using real Razorpay test checkout (recommended).
ALLOW_SANDBOX_CONFIRM=false

# Integration test (real sandbox services, no production):
#   Copy .env.integration.example → merge into .env
#   Set EXPO_PUBLIC_API_URL=http://localhost:3001
#   Keep EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_... + RAZORPAY_KEY_SECRET
#   Run: npm run api:dev (terminal 1) + npm run web (terminal 2)
#   Verify: npm run test:stack
